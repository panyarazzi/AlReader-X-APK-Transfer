    d1 = {
        "\u0000\u00ca\u0001\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0008\u0002\n\u0002\u0010\u0002\n\u0002\u0008\u0002\n\u0002\u0010\u0012\n\u0002\u0008\u0002\n\u0002\u0010\u0008\n\u0002\u0008\u0005\n\u0002\u0010 \n\u0002\u0018\u0002\n\u0002\u0008\u0004\n\u0002\u0018\u0002\n\u0002\u0008\u0005\n\u0002\u0018\u0002\n\u0002\u0008\u0002\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0008\u0007\n\u0002\u0010\t\n\u0002\u0008%\n\u0002\u0018\u0002\n\u0000\n\u0002\u0010\u000b\n\u0002\u0008\u000c\n\u0002\u0010\u000e\n\u0000\n\u0002\u0018\u0002\n\u0000\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0008\u0010\n\u0002\u0018\u0002\n\u0002\u0008\u000e\n\u0002\u0018\u0002\n\u0002\u0008\u0003\n\u0002\u0018\u0002\n\u0002\u0008\u0005\n\u0002\u0010!\n\u0002\u0008\u0011\n\u0002\u0018\u0002\n\u0002\u0018\u0002\n\u0002\u0008\u0011\n\u0002\u0010%\n\u0002\u0008\u0004\n\u0002\u0018\u0002\n\u0002\u0008\u0002\n\u0002\u0018\u0002\n\u0002\u0008\u0003\n\u0002\u0018\u0002\n\u0002\u0008!\u0018\u00002\u00020\u0001:\u0016\u00d4\u0001\u00d5\u0001\u00d6\u0001\u00d7\u0001\u00d8\u0001\u00d9\u0001\u00da\u0001\u00db\u0001\u00dc\u0001\u00dd\u0001\u00de\u0001B\u0007\u00a2\u0006\u0004\u0008\u0002\u0010\u0003J\u000f\u0010\u0005\u001a\u00020\u0004H\u0002\u00a2\u0006\u0004\u0008\u0005\u0010\u0003J\u000f\u0010\u0006\u001a\u00020\u0004H\u0002\u00a2\u0006\u0004\u0008\u0006\u0010\u0003J\u0015\u0010\u0008\u001a\u00020\u0004*\u0004\u0018\u00010\u0007H\u0002\u00a2\u0006\u0004\u0008\u0008\u0010\tJ\u0017\u0010\u000c\u001a\u00020\n2\u0006\u0010\u000b\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u0008\u000c\u0010\rJ\u000f\u0010\u000e\u001a\u00020\u0004H\u0002\u00a2\u0006\u0004\u0008\u000e\u0010\u0003J\u000f\u0010\u000f\u001a\u00020\u0004H\u0002\u00a2\u0006\u0004\u0008\u000f\u0010\u0003J%\u0010\u0014\u001a\u00020\u00072\u000c\u0010\u0012\u001a\u0008\u0012\u0004\u0012\u00020\u00110\u00102\u0006\u0010\u0013\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u0008\u0014\u0010\u0015J\u0017\u0010\u0017\u001a\u00020\u00162\u0006\u0010\u0013\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u0008\u0017\u0010\u0018J\u0017\u0010\u0019\u001a\u00020\u00162\u0006\u0010\u0013\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u0008\u0019\u0010\u0018J\u000f\u0010\u001a\u001a\u00020\u0004H\u0002\u00a2\u0006\u0004\u0008\u001a\u0010\u0003J\u0015\u0010\u001b\u001a\u00020\u0004*\u0004\u0018\u00010\u0007H\u0002\u00a2\u0006\u0004\u0008\u001b\u0010\tJ\u0017\u0010\u001d\u001a\u00020\u001c2\u0006\u0010\u000b\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u0008\u001d\u0010\u001eJ#\u0010#\u001a\u00020\u0004*\u00020\u001f2\u0006\u0010!\u001a\u00020 2\u0006\u0010\"\u001a\u00020 H\u0002\u00a2\u0006\u0004\u0008#\u0010$J\u001b\u0010&\u001a\u00020\u0004*\u00020\u001f2\u0006\u0010%\u001a\u00020 H\u0002\u00a2\u0006\u0004\u0008&\u0010\'J\u001b\u0010*\u001a\u00020\u0004*\u00020 2\u0006\u0010)\u001a\u00020(H\u0002\u00a2\u0006\u0004\u0008*\u0010+J\u001b\u0010*\u001a\u00020\u0004*\u00020 2\u0006\u0010,\u001a\u00020 H\u0002\u00a2\u0006\u0004\u0008*\u0010-J\u000f\u0010.\u001a\u00020\u0004H\u0002\u00a2\u0006\u0004\u0008.\u0010\u0003J\u0017\u00100\u001a\u00020\u00042\u0006\u0010/\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u00080\u00101J\u0015\u00102\u001a\u00020\u0004*\u0004\u0018\u00010\u0007H\u0002\u00a2\u0006\u0004\u00082\u0010\tJ\u0017\u00103\u001a\u00020\u00042\u0006\u0010/\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u00083\u00101J\u000f\u00104\u001a\u00020\u0004H\u0002\u00a2\u0006\u0004\u00084\u0010\u0003J\u001b\u00106\u001a\u00020\n*\u00020\u00072\u0006\u00105\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u00086\u00107J\u0015\u00108\u001a\u00020\u0004*\u0004\u0018\u00010\u0007H\u0002\u00a2\u0006\u0004\u00088\u0010\tJ\u0015\u00109\u001a\u00020\u0004*\u0004\u0018\u00010\u0007H\u0002\u00a2\u0006\u0004\u00089\u0010\tJ\u000f\u0010:\u001a\u00020\u0004H\u0002\u00a2\u0006\u0004\u0008:\u0010\u0003J\u0015\u0010;\u001a\u00020\u0004*\u0004\u0018\u00010\u0007H\u0002\u00a2\u0006\u0004\u0008;\u0010\tJ#\u0010>\u001a\u00020\u0004*\u00020\u00072\u0006\u0010<\u001a\u00020\n2\u0006\u0010=\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u0008>\u0010?J\u0017\u0010A\u001a\u00020\n2\u0006\u0010@\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u0008A\u0010\rJ\u0017\u0010B\u001a\u00020\n2\u0006\u0010<\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u0008B\u0010\rJ#\u0010C\u001a\u00020\n*\u00020\u00072\u0006\u0010<\u001a\u00020\n2\u0006\u0010=\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u0008C\u0010DJ#\u0010F\u001a\u00020\u0004*\u00020\u00072\u0006\u0010=\u001a\u00020\n2\u0006\u0010E\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u0008F\u0010?J\u001d\u0010G\u001a\u00020\u0004*\u0004\u0018\u00010\u00072\u0006\u0010=\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u0008G\u0010HJ\u001d\u0010I\u001a\u00020\u0004*\u0004\u0018\u00010\u00072\u0006\u0010=\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u0008I\u0010HJ\u0017\u0010K\u001a\u00020\u00042\u0006\u0010J\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u0008K\u00101J\u000f\u0010L\u001a\u00020\u0004H\u0002\u00a2\u0006\u0004\u0008L\u0010\u0003J\u0015\u0010M\u001a\u00020\u0004*\u0004\u0018\u00010\u0007H\u0002\u00a2\u0006\u0004\u0008M\u0010\tJ\u001f\u0010Q\u001a\u00020P2\u0006\u0010=\u001a\u00020\n2\u0006\u0010O\u001a\u00020NH\u0002\u00a2\u0006\u0004\u0008Q\u0010RJ\'\u0010T\u001a\u00020P2\u0006\u0010=\u001a\u00020\n2\u0006\u0010S\u001a\u00020\n2\u0006\u0010O\u001a\u00020NH\u0002\u00a2\u0006\u0004\u0008T\u0010UJ\'\u0010V\u001a\u00020P2\u0006\u0010=\u001a\u00020\n2\u0006\u0010S\u001a\u00020\n2\u0006\u0010O\u001a\u00020NH\u0002\u00a2\u0006\u0004\u0008V\u0010UJ\u0017\u0010W\u001a\u00020\u00042\u0006\u0010O\u001a\u00020NH\u0002\u00a2\u0006\u0004\u0008W\u0010XJ\'\u0010[\u001a\u00020P2\u0006\u0010Y\u001a\u00020\n2\u0006\u0010Z\u001a\u00020\u00072\u0006\u0010E\u001a\u00020\nH\u0002\u00a2\u0006\u0004\u0008[\u0010\\J;\u0010e\u001a\u00020\n2\u0006\u0010^\u001a\u00020]2\u0006\u0010`\u001a\u00020_2\u001a\u0010d\u001a\u0016\u0012\u0004\u0012\u00020b\u0018\u00010aj\n\u0012\u0004\u0012\u00020b\u0018\u0001`cH\u0016\u00a2\u0006\u0004\u0008e\u0010fJ\u000f\u0010g\u001a\u00020\nH\u0016\u00a2\u0006\u0004\u0008g\u0010hJ\'\u0010j\u001a\u00020\n2\u0006\u0010=\u001a\u00020(2\u0006\u0010Z\u001a\u00020\u00072\u0006\u0010i\u001a\u00020\nH\u0016\u00a2\u0006\u0004\u0008j\u0010kJ\u0015\u0010l\u001a\u00020\u00042\u0006\u0010=\u001a\u00020\n\u00a2\u0006\u0004\u0008l\u00101J\u0015\u0010m\u001a\u00020\u00042\u0006\u0010=\u001a\u00020\n\u00a2\u0006\u0004\u0008m\u00101J\u0015\u0010n\u001a\u00020P2\u0006\u0010O\u001a\u00020N\u00a2\u0006\u0004\u0008n\u0010oJ7\u0010r\u001a\u00020P2\u0006\u0010p\u001a\u00020\n2\u0006\u0010=\u001a\u00020\n2\u0006\u0010Z\u001a\u00020\u00072\u0006\u0010q\u001a\u00020\n2\u0006\u0010i\u001a\u00020\nH\u0016\u00a2\u0006\u0004\u0008r\u0010sR\u0016\u0010u\u001a\u00020t8\u0002@\u0002X\u0082.\u00a2\u0006\u0006\n\u0004\u0008u\u0010vR\u0016\u0010%\u001a\u00020 8\u0006@\u0006X\u0087\u000e\u00a2\u0006\u0006\n\u0004\u0008%\u0010wR\"\u0010x\u001a\u00020]8\u0006@\u0006X\u0086\u000e\u00a2\u0006\u0012\n\u0004\u0008x\u0010y\u001a\u0004\u0008z\u0010{\"\u0004\u0008|\u0010}R\u0014\u0010~\u001a\u00020 8\u0002X\u0082\u0004\u00a2\u0006\u0006\n\u0004\u0008~\u0010wR\u0017\u0010\u007f\u001a\u00020\n8\u0002@\u0002X\u0082\u000e\u00a2\u0006\u0007\n\u0005\u0008\u007f\u0010\u0080\u0001R\u0019\u0010\u0081\u0001\u001a\u00020\n8\u0002@\u0002X\u0082\u000e\u00a2\u0006\u0008\n\u0006\u0008\u0081\u0001\u0010\u0080\u0001R\u0019\u0010\u0082\u0001\u001a\u00020\n8\u0002@\u0002X\u0082\u000e\u00a2\u0006\u0008\n\u0006\u0008\u0082\u0001\u0010\u0080\u0001R\u001a\u0010\u0084\u0001\u001a\u00030\u0083\u00018\u0002@\u0002X\u0082.\u00a2\u0006\u0008\n\u0006\u0008\u0084\u0001\u0010\u0085\u0001R\u0019\u0010\u0086\u0001\u001a\u00020\n8\u0002@\u0002X\u0082\u000e\u00a2\u0006\u0008\n\u0006\u0008\u0086\u0001\u0010\u0080\u0001R+\u0010\u0088\u0001\u001a\u0014\u0012\u0005\u0012\u00030\u0087\u00010aj\t\u0012\u0005\u0012\u00030\u0087\u0001`c8\u0002@\u0002X\u0082.\u00a2\u0006\u0008\n\u0006\u0008\u0088\u0001\u0010\u0089\u0001R\u0019\u0010\u008a\u0001\u001a\u00020\n8\u0002@\u0002X\u0